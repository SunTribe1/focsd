---
import Search from '@astrojs/starlight/components/Search.astro';
import lockup from '../../../../../docs/brand/logo/svg/focsd-horizontal-ink.svg?raw';
import { REPO_URL } from '../../data/site.js';

const mark = lockup.replace(/<title>.*?<\/title>/, '').replace(/fill="#[0-9A-Fa-f]{6}"/g, 'fill="currentColor"');

const links = [
  { label: 'Docs', href: '/getting-started/installation/' },
  { label: 'Components', href: '/components/' },
];
---

<header class="lp-header" data-lp-header>
  <div class="lp-header-inner">
    <a class="lp-brand" href="/" aria-label="Focsd home">
      <span class="lp-lockup" aria-hidden="true" set:html={mark} />
    </a>
    <nav class="lp-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lp-actions">
      <Search />
      <a class="lp-icon-button" href={REPO_URL} aria-label="Focsd on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
        </svg>
      </a>
      <button class="lp-icon-button" type="button" data-lp-theme aria-label="Dark theme" aria-pressed="false">
        <svg class="lp-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <button
        class="lp-icon-button lp-menu-button"
        type="button"
        data-lp-menu
        aria-expanded="false"
        aria-controls="lp-mobile-nav"
        aria-label="Menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav class="lp-mobile-nav" id="lp-mobile-nav" aria-label="Site" hidden>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
      <li>
        <a href={REPO_URL}>GitHub</a>
      </li>
    </ul>
  </nav>
</header>
