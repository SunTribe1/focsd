{
  "name": "@focsd/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=chrome-webmcp",
    "coverage": "COVERAGE=1 playwright test --project=chromium && node scripts/check-coverage.mjs",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@focsd/ai": "workspace:*",
    "@focsd/charts": "workspace:*",
    "@focsd/components": "workspace:*",
    "@focsd/data-grid": "workspace:*",
    "@focsd/editor": "workspace:*",
    "@focsd/primitives": "workspace:*",
    "@focsd/react": "workspace:*",
    "@focsd/tokens": "workspace:*",
    "@focsd/webmcp": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@playwright/test": "1.65.1",
    "lit": "3.3.3",
    "lucide": "1.79.0",
    "monocart-coverage-reports": "2.13.2",
    "vite": "8.3.8"
  }
}
