{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**/*.mjs", "$TURBO_ROOT$/custom-elements-manifest.config.mjs"],
      "outputs": ["dist/**", "data/**", "custom-elements.json", "types/**", "vscode.*-custom-data.json", "web-types.json"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@focsd/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/components-catalogue.md", "$TURBO_ROOT$/scripts/agent/**"],
      "outputs": ["dist/**"]
    },
    "@focsd/docs#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/agent/**"],
      "outputs": []
    },
    "@focsd/mcp#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/components-catalogue.md", "$TURBO_ROOT$/apps/docs/src/data/examples/**"],
      "outputs": ["data/**"]
    }
  }
}
