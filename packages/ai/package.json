{
  "name": "@focsd/ai",
  "version": "1.0.0",
  "description": "Focsd AI kit: accessible chat UI elements, a safe streaming markdown renderer and a chat controller over a pluggable transport.",
  "license": "MIT",
  "homepage": "https://focsd.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunTribe1/focsd.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/SunTribe1/focsd/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "ai",
    "chat",
    "component-library",
    "custom-elements",
    "design-system",
    "framework-agnostic",
    "free",
    "frontend",
    "lit",
    "llm",
    "streaming",
    "ui",
    "ui-components",
    "ui-library",
    "wcag",
    "web-components"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "development": "./src/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./*.js": {
      "types": "./types/*.d.ts",
      "development": "./src/*.js",
      "default": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./vscode.html-custom-data.json",
    "./vscode.css-custom-data.json": "./vscode.css-custom-data.json",
    "./web-types.json": "./web-types.json",
    "./package.json": "./package.json"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "src",
    "types",
    "vscode.css-custom-data.json",
    "vscode.html-custom-data.json",
    "web-types.json",
    "LICENSE-lucide.txt"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build-dist.mjs && pnpm analyze && pnpm types",
    "analyze": "cd ../.. && cem analyze --globs \"packages/ai/src/**/*.js\" --litelement --outdir packages/ai",
    "test": "vitest run && tsc -p test/types",
    "types": "node ../../scripts/emit-types.mjs && node ../../scripts/type-integrations.mjs"
  },
  "dependencies": {
    "@focsd/components": "workspace:*",
    "@focsd/primitives": "workspace:*",
    "@focsd/tokens": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@lit-labs/ssr": "4.1.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.3",
    "happy-dom": "20.14.5"
  },
  "sideEffects": [
    "./src/index.js",
    "./dist/index.js",
    "./src/attachment-tile.js",
    "./src/chat-message.js",
    "./src/chat-thread.js",
    "./src/composer.js",
    "./src/file-changes.js",
    "./src/input-icons.js",
    "./src/message-actions.js",
    "./src/prompt-suggestions.js",
    "./src/reasoning.js",
    "./src/source-chip.js",
    "./src/streaming-text.js",
    "./src/terms.js",
    "./src/tool-call.js",
    "./dist/attachment-tile.js",
    "./dist/chat-message.js",
    "./dist/chat-thread.js",
    "./dist/composer.js",
    "./dist/file-changes.js",
    "./dist/input-icons.js",
    "./dist/message-actions.js",
    "./dist/prompt-suggestions.js",
    "./dist/reasoning.js",
    "./dist/source-chip.js",
    "./dist/streaming-text.js",
    "./dist/terms.js",
    "./dist/tool-call.js"
  ],
  "web-types": "./web-types.json",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
