{
  "name": "@focsd/react",
  "version": "1.0.0",
  "description": "React wrappers for Focsd components.",
  "license": "MIT",
  "homepage": "https://focsd.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunTribe1/focsd.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/SunTribe1/focsd/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "component-library",
    "custom-elements",
    "design-system",
    "framework-agnostic",
    "free",
    "frontend",
    "lit",
    "react",
    "ui",
    "ui-components",
    "ui-library",
    "wcag",
    "web-components"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/elements/*.d.ts",
      "default": "./src/elements/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@focsd/components": "workspace:*"
  },
  "peerDependencies": {
    "@focsd/ai": "workspace:^",
    "@focsd/charts": "workspace:^",
    "@focsd/data-grid": "workspace:^",
    "@focsd/editor": "workspace:^",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@focsd/ai": {
      "optional": true
    },
    "@focsd/charts": {
      "optional": true
    },
    "@focsd/data-grid": {
      "optional": true
    },
    "@focsd/editor": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node scripts/generate.mjs --check && node --test test/*.test.mjs && tsc -p test/types"
  },
  "devDependencies": {
    "@focsd/ai": "workspace:*",
    "@focsd/charts": "workspace:*",
    "@focsd/data-grid": "workspace:*",
    "@focsd/editor": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "7.0.2"
  }
}
